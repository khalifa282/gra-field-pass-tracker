<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fp_dashboard_form" model="ir.ui.view">
        <field name="name">field.pass.dashboard.form</field>
        <field name="model">field.pass.dashboard</field>
        <field name="arch" type="xml">
            <form string="Field Pass Dashboard" create="false" delete="false">
                <sheet><div style="max-width:1200px;padding:8px 0 24px;">
                <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;padding:12px 16px;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;">
                    <span style="font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">Filter by Department - تصفية حسب القسم:</span>
                    <field name="department_id" style="flex:1;max-width:300px;" options="{'no_create': True, 'no_quick_create': True}" placeholder="All Departments"/>
                    <button name="action_refresh" type="object" string="Apply" class="btn btn-primary"/>
                </div>
