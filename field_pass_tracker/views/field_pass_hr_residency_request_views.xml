<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Main request: tree ──────────────────────────────────────────── -->
    <record id="view_fp_hr_residency_request_tree" model="ir.ui.view">
        <field name="name">field.pass.hr.residency.request.tree</field>
        <field name="model">field.pass.hr.residency.request</field>
        <field name="arch" type="xml">
            <tree string="Residency Transfer Requests - طلبات تحويل الإقامة"
                  decoration-danger="state=='rejected'" decoration-success="state=='completed'"
                  decoration-info="state in ('check_submitted','transfer_submitted')">
                <field name="name"/>
                <field name="candidate_name"/>
                <field name="fp_company_id"/>
                <field name="department_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ── Main request: form ──────────────────────────────────────────── -->
    <record id="view_fp_hr_residency_request_form" model="ir.ui.view">
        <field name="name">field.pass.hr.residency.request.form</field>
        <field name="model">field.pass.hr.residency.request</field>
        <field name="arch" type="xml">
            <form string="Residency Transfer Request - طلب تحويل الإقامة">
                <header>
                    <button name="action_submit_check" type="object" string="Submit for Check - إرسال للفحص"
                            class="btn-primary" attrs="{'invisible': [('state','!=','draft')]}"
                            groups="field_pass_tracker.group_fp_hr_admin"/>
                    <button name="action_open_check_wizard" type="object" string="GRO: Respond - رد الجهة الحكومية"
                            class="btn-primary" attrs="{'invisible': [('state','!=','check_submitted')]}"
                            groups="field_pass_tracker.group_fp_admin"/>
                    <button name="action_submit_transfer" type="object" string="Submit Transfer Request - إرسال طلب النقل"
                            class="btn-primary" attrs="{'invisible': ['|', ('state','!=','check_done'), ('transferable','!=','yes')]}"
                            groups="field_pass_tracker.group_fp_hr_admin"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject - رفض"
                            class="btn-danger" attrs="{'invisible': [('state','!=','transfer_submitted')]}"
                            groups="field_pass_tracker.group_fp_admin"/>
                    <button name="action_mark_under_process" type="object" string="Mark Under Process - قيد المعالجة"
                            class="btn-primary" attrs="{'invisible': [('state','!=','transfer_submitted')]}"
                            groups="field_pass_tracker.group_fp_admin"/>
                    <button name="action_submit_for_approval" type="object" string="Submit for Approval - إرسال للموافقة"
                            class="btn-primary" attrs="{'invisible': [('state','!=','under_process')]}"
                            groups="field_pass_tracker.group_fp_admin"/>
                    <button name="action_complete" type="object" string="Complete - إكمال"
                            class="btn-primary" attrs="{'invisible': [('state','!=','pending_approval')]}"
                            groups="field_pass_tracker.group_fp_manager"/>
                    <button name="action_reopen" type="object" string="Reopen - إعادة فتح"
                            class="btn-primary" attrs="{'invisible': [('state','!=','rejected')]}"
                            groups="field_pass_tracker.group_fp_hr_admin"/>
                    <button name="action_close" type="object" string="Close - إغلاق"
                            class="btn-secondary" attrs="{'invisible': [('state','!=','rejected')]}"
                            groups="field_pass_tracker.group_fp_hr_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,check_submitted,check_done,transfer_submitted,pending_approval,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group string="Candidate Details - بيانات المرشح">
                        <group>
                            <field name="candidate_name"/>
                            <field name="candidate_name_ar"/>
                            <field name="civil_id"/>
                            <field name="candidate_contact_no"/>
                        </group>
                        <group>
                            <field name="fp_company_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="internal_position_title"/>
                            <field name="suggested_position_title"/>
                        </group>
                    </group>

                    <group string="Check-Stage Documents - مستندات مرحلة الفحص">
                        <field name="attachment_passport" widget="binary" filename="attachment_passport_name" string="Passport - جواز السفر"/>
                        <field name="attachment_passport_name" invisible="1"/>
                        <field name="passport_validity"/>
                        <field name="attachment_civil_id" widget="binary" filename="attachment_civil_id_name" string="Civil ID - البطاقة المدنية"/>
                        <field name="attachment_civil_id_name" invisible="1"/>
                        <field name="attachment_work_permit" widget="binary" filename="attachment_work_permit_name" string="Work Permit - إذن العمل"/>
                        <field name="attachment_work_permit_name" invisible="1"/>
                        <field name="attachment_driving_license" widget="binary" filename="attachment_driving_license_name" string="Driving License (Optional) - رخصة القيادة (اختياري)"/>
                        <field name="attachment_driving_license_name" invisible="1"/>
                        <field name="driving_license_validity"/>
                        <field name="attachment_education_cert" widget="binary" filename="attachment_education_cert_name" string="Education Certificate - الشهادة الدراسية"/>
                        <field name="attachment_education_cert_name" invisible="1"/>
                    </group>

                    <group string="GRO Check Response - رد الجهة الحكومية"
                           attrs="{'invisible': [('state','in',['draft','check_submitted'])]}">
                        <field name="transferable" readonly="1"/>
                        <field name="transferable_comments" readonly="1"/>
                    </group>

                    <group string="Transfer Request - طلب النقل"
                           attrs="{'invisible': ['|', ('state','in',['draft','check_submitted']), ('transferable','=','no')]}">
                        <field name="salary" attrs="{'readonly': [('state','!=','check_done')]}"/>
                    </group>

                    <group string="Rejection - الرفض"
                           attrs="{'invisible': ['|', ('state','!=','rejected'), ('transferable','=','no')]}">
                        <field name="rejection_reason" readonly="1"/>
                    </group>

                    <group string="Completion Documents - مستندات الإكمال"
                           attrs="{'invisible': [('state','not in',['under_process','pending_approval','completed'])]}">
                        <field name="attachment_final_work_permit" widget="binary" filename="attachment_final_work_permit_name" string="Work Permit - اذن العمل"/>
                        <field name="attachment_final_work_permit_name" invisible="1"/>
                        <field name="work_permit_validity"/>
                        <field name="attachment_health_insurance" widget="binary" filename="attachment_health_insurance_name" string="Health Insurance - الضمان الصحي"/>
                        <field name="attachment_health_insurance_name" invisible="1"/>
                        <field name="attachment_moi_migration" widget="binary" filename="attachment_moi_migration_name" string="MOI Migration - الهجرة"/>
                        <field name="attachment_moi_migration_name" invisible="1"/>
                        <field name="attachment_final_civil_id" widget="binary" filename="attachment_final_civil_id_name" string="Civil ID - البطاقة المدنية"/>
                        <field name="attachment_final_civil_id_name" invisible="1"/>
                        <field name="civil_id_validity"/>
                    </group>

                    <notebook>
                        <page name="history" string="History - السجل">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="event_date"/>
                                    <field name="event_by"/>
                                    <field name="event_type" widget="badge"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fp_hr_residency_request" model="ir.actions.act_window">
        <field name="name">Residency Transfer Requests - طلب تحويل اقامه</field>
        <field name="res_model">field.pass.hr.residency.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── GRO Check Response wizard ───────────────────────────────────── -->
    <record id="view_fp_hr_residency_check_wizard_form" model="ir.ui.view">
        <field name="name">field.pass.hr.residency.check.wizard.form</field>
        <field name="model">field.pass.hr.residency.check.wizard</field>
        <field name="arch" type="xml">
            <form string="GRO Response - رد الجهة الحكومية">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="transferable"/>
                    <field name="comments"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm - تأكيد" class="btn-primary"/>
                    <button special="cancel" string="Cancel - إلغاء"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Reject wizard ───────────────────────────────────────────────── -->
    <record id="view_fp_hr_residency_reject_wizard_form" model="ir.ui.view">
        <field name="name">field.pass.hr.residency.reject.wizard.form</field>
        <field name="model">field.pass.hr.residency.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request - رفض الطلب">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm - تأكيد" class="btn-primary"/>
                    <button special="cancel" string="Cancel - إلغاء"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
