<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fp_dashboard_form" model="ir.ui.view">
        <field name="name">field.pass.dashboard.form</field>
        <field name="model">field.pass.dashboard</field>
        <field name="arch" type="xml">
            <form string="Field Pass Dashboard" create="false" delete="false">
                <sheet>
                    <div style="max-width:1300px;padding:8px 0 24px;">

                        <notebook>
                            <page name="field_passes" string="Field Passes - التصاريح" groups="field_pass_tracker.group_fp_viewer,field_pass_tracker.group_fp_ops_viewer">
                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;margin-top:8px;">Employee Field Passes - تصاريح حقول الموظفين</div>
                                <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:24px;">
                                    <button name="action_emp_pass_expired" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="emp_pass_expired" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Expired - منتهي</div>
                                        </div>
                                    </button>
                                    <button name="action_emp_pass_warning" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fef3c7;border:1px solid #fcd34d;border-left:4px solid #d97706;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#d97706;line-height:1;"><field name="emp_pass_warning" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#d97706;margin-top:6px;">Expiring Soon - ينتهي قريباً</div>
                                        </div>
                                    </button>
                                    <button name="action_emp_pass_missing" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fce7f3;border:1px solid #f9a8d4;border-left:4px solid #db2777;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#db2777;line-height:1;"><field name="emp_pass_missing" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#db2777;margin-top:6px;">Incompleted - غير مكتملة</div>
                                        </div>
                                    </button>
                                    <button name="action_emp_pass_temp" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fff7ed;border:1px solid #fed7aa;border-left:4px solid #ea580c;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#ea580c;line-height:1;"><field name="emp_pass_temp" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#ea580c;margin-top:6px;">Temp Pass - تصريح مؤقت</div>
                                        </div>
                                    </button>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="emp_pass_valid" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">All Valid - جميع سارية</div>
                                    </div>
                                </div>
                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;">Vehicle Field Passes - تصاريح حقول المركبات</div>
                                <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:24px;">
                                    <button name="action_veh_pass_expired" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="veh_pass_expired" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Expired - منتهي</div>
                                        </div>
                                    </button>
                                    <button name="action_veh_pass_warning" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fef3c7;border:1px solid #fcd34d;border-left:4px solid #d97706;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#d97706;line-height:1;"><field name="veh_pass_warning" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#d97706;margin-top:6px;">Expiring Soon - ينتهي قريباً</div>
                                        </div>
                                    </button>
                                    <button name="action_veh_pass_missing" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fce7f3;border:1px solid #f9a8d4;border-left:4px solid #db2777;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#db2777;line-height:1;"><field name="veh_pass_missing" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#db2777;margin-top:6px;">Incompleted - غير مكتملة</div>
                                        </div>
                                    </button>
                                    <button name="action_veh_pass_temp" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fff7ed;border:1px solid #fed7aa;border-left:4px solid #ea580c;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#ea580c;line-height:1;"><field name="veh_pass_temp" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#ea580c;margin-top:6px;">Temp Pass - تصريح مؤقت</div>
                                        </div>
                                    </button>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="veh_pass_valid" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">All Valid - جميع سارية</div>
                                    </div>
                                </div>
                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">Progress - المعاملات</div>
                                <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px;">
                                    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid #7c3aed;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#7c3aed;line-height:1;"><field name="pass_app_submitted" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#7c3aed;margin-top:6px;">Submitted - مقدم</div>
                                    </div>
                                    <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #9f1239;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#9f1239;line-height:1;"><field name="pass_app_rejected" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#9f1239;margin-top:6px;">Rejected - مرفوض</div>
                                    </div>
                                </div>
                                <field name="recent_app_ids" nolabel="1" readonly="1">
                                    <tree string="Recent Applications" create="false" delete="false" editable="false"
                                          decoration-success="state == 'issued'"
                                          decoration-danger="state == 'rejected'"
                                          decoration-info="state == 'submitted'">
                                        <field name="event_date" string="Date"/>
                                        <field name="employee_id" string="Employee"/>
                                        <field name="vehicle_id" string="Vehicle"/>
                                        <field name="pass_type" string="Pass Type"/>
                                        <field name="event_by" string="By"/>
                                        <field name="state" string="Status" widget="badge"
                                               decoration-success="state == 'issued'"
                                               decoration-danger="state == 'rejected'"
                                               decoration-info="state == 'submitted'"/>
                                        <field name="rejection_reason" string="Remarks"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="documents" string="Documents - المستندات">
                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;margin-top:8px;">Employee Documents - مستندات الموظفين</div>
                                <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:24px;">
                                    <button name="action_emp_doc_expired" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="emp_doc_expired" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Expired - منتهي</div>
                                        </div>
                                    </button>
                                    <button name="action_emp_doc_warning" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fef3c7;border:1px solid #fcd34d;border-left:4px solid #d97706;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#d97706;line-height:1;"><field name="emp_doc_warning" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#d97706;margin-top:6px;">Expiring Soon - ينتهي قريباً</div>
                                        </div>
                                    </button>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="emp_doc_valid" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">Valid - ساري</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #94a3b8;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#334155;line-height:1;"><field name="emp_total" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#64748b;margin-top:6px;">Total Employees</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;height:90px;"></div>
                                </div>
                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;">Vehicle Documents - مستندات المركبات</div>
                                <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:24px;">
                                    <button name="action_veh_doc_expired" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="veh_doc_expired" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Expired - منتهي</div>
                                        </div>
                                    </button>
                                    <button name="action_veh_doc_warning" type="object" style="border:none;padding:0;background:none;cursor:pointer;display:block;">
                                        <div style="background:#fef3c7;border:1px solid #fcd34d;border-left:4px solid #d97706;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                            <div style="font-size:28px;font-weight:700;color:#d97706;line-height:1;"><field name="veh_doc_warning" readonly="1"/></div>
                                            <div style="font-size:11px;font-weight:600;color:#d97706;margin-top:6px;">Expiring Soon - ينتهي قريباً</div>
                                        </div>
                                    </button>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="veh_doc_valid" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">Valid - ساري</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #94a3b8;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#334155;line-height:1;"><field name="veh_total" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#64748b;margin-top:6px;">Total Vehicles</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;height:90px;"></div>
                                </div>
                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">Progress - المعاملات</div>
                                <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px;">
                                    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid #2563eb;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#2563eb;line-height:1;"><field name="renewal_submitted" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#2563eb;margin-top:6px;">Submitted - مقدم</div>
                                    </div>
                                    <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="renewal_rejected" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Rejected - مرفوض</div>
                                    </div>
                                </div>
                                <field name="recent_renewal_ids" nolabel="1" readonly="1">
                                    <tree string="Recent Renewals" create="false" delete="false" editable="false"
                                          decoration-success="event_type == 'issued'"
