                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;margin-top:10px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">Needs Attention - يحتاج إلى متابعة</div>
                                <field name="company_doc_alert_ids" nolabel="1" readonly="1">
                                    <tree string="Company Documents Needing Attention" create="false" delete="false" editable="false"
                                          decoration-danger="status=='expired'" decoration-warning="status=='warning'">
                                        <field name="company_id" string="Company - الشركة"/>
                                        <field name="name" string="Document (EN) - المستند"/>
                                        <field name="name_ar" string="Document (AR) - بالعربية"/>
                                        <field name="related_authority" string="Ministry/Body - الجهة الحكومية"/>
                                        <field name="validity_date" string="Expiry Date - تاريخ الانتهاء"/>
                                        <field name="days_remaining" string="Days Left - الأيام المتبقية"/>
                                        <field name="status" string="Status - الحالة" widget="badge"
                                               decoration-danger="status=='expired'" decoration-warning="status=='warning'"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="hr" string="HR - الموارد البشرية" groups="field_pass_tracker.group_fp_viewer,field_pass_tracker.group_fp_hr_viewer,field_pass_tracker.group_fp_ops_manager">
                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;margin-top:8px;">Residency Transfer Requests - طلب تحويل اقامه</div>
                                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px;">
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #94a3b8;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#334155;line-height:1;"><field name="hr_residency_draft" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#64748b;margin-top:6px;">Draft - مسودة</div>
                                    </div>
                                    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid #2563eb;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#2563eb;line-height:1;"><field name="hr_residency_active" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#2563eb;margin-top:6px;">In Progress - قيد التنفيذ</div>
                                    </div>
                                    <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="hr_residency_rejected" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Rejected - مرفوض</div>
                                    </div>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="hr_residency_completed" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">Completed - مكتمل</div>
                                    </div>
                                </div>
                                <field name="hr_residency_alert_ids" nolabel="1" readonly="1">
                                    <tree string="Residency Requests In Progress" create="false" delete="false" editable="false"
                                          decoration-danger="state=='rejected'" decoration-info="state not in ('rejected','completed')">
                                        <field name="name" string="Reference - المرجع"/>
                                        <field name="candidate_name" string="Candidate - المرشح"/>
                                        <field name="department_id" string="Department - القسم"/>
                                        <field name="state" string="Status - الحالة" widget="badge"
                                               decoration-danger="state=='rejected'" decoration-info="state not in ('rejected','completed')"/>
                                        <field name="last_action_by" string="By - بواسطة"/>
                                        <field name="create_date" string="Created - تاريخ الإنشاء"/>
                                    </tree>
                                </field>

                                <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:10px;margin-top:24px;">Work Visa Requests - طلبات سمة الدخول</div>
                                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px;">
