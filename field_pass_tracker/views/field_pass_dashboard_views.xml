                                    </div>
                                    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid #2563eb;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#2563eb;line-height:1;"><field name="hr_visa_active" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#2563eb;margin-top:6px;">In Progress - قيد التنفيذ</div>
                                    </div>
                                    <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#dc2626;line-height:1;"><field name="hr_visa_rejected" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#dc2626;margin-top:6px;">Rejected - مرفوض</div>
                                    </div>
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;height:90px;display:flex;flex-direction:column;justify-content:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;line-height:1;"><field name="hr_visa_closed" readonly="1"/></div>
                                        <div style="font-size:11px;font-weight:600;color:#16a34a;margin-top:6px;">Closed - مغلق</div>
                                    </div>
                                </div>
                                <field name="hr_visa_alert_ids" nolabel="1" readonly="1">
                                    <tree string="Work Visa Requests In Progress" create="false" delete="false" editable="false"
                                          decoration-danger="state=='rejected'" decoration-info="state not in ('rejected','closed')">
                                        <field name="name" string="Reference - المرجع"/>
                                        <field name="candidate_name" string="Candidate - المرشح"/>
                                        <field name="department_id" string="Department - القسم"/>
                                        <field name="state" string="Status - الحالة" widget="badge"
                                               decoration-danger="state=='rejected'" decoration-info="state not in ('rejected','closed')"/>
                                        <field name="last_action_by" string="By - بواسطة"/>
                                        <field name="create_date" string="Created - تاريخ الإنشاء"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="statistics" string="Statistics - الإحصائيات" groups="field_pass_tracker.group_fp_manager,field_pass_tracker.group_fp_hr_manager">
                                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px;margin-top:8px;">
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #7c3aed;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#7c3aed;"><field name="stat_avg_doc_days" readonly="1"/> days</div>
                                        <div style="font-size:12px;font-weight:600;color:#64748b;margin-top:6px;">Avg Document Processing - متوسط معالجة المستندات</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #2563eb;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#2563eb;"><field name="stat_avg_pass_days" readonly="1"/> days</div>
                                        <div style="font-size:12px;font-weight:600;color:#64748b;margin-top:6px;">Avg Pass Processing - متوسط معالجة التصاريح</div>
                                    </div>
                                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;"><field name="stat_total_completed" readonly="1"/></div>
                                        <div style="font-size:12px;font-weight:600;color:#64748b;margin-top:6px;">Total Completed - إجمالي المكتملة</div>
                                    </div>
                                </div>
                                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px;">
                                    <div style="background:#dcfce7;border:1px solid #86efac;border-left:4px solid #16a34a;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#16a34a;"><field name="stat_fastest_days" readonly="1"/> days</div>
                                        <div style="font-size:12px;font-weight:600;color:#065f46;margin-top:6px;">Fastest Completion - أسرع إتمام</div>
                                    </div>
                                    <div style="background:#fee2e2;border:1px solid #fca5a5;border-left:4px solid #dc2626;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#dc2626;"><field name="stat_slowest_days" readonly="1"/> days</div>
                                        <div style="font-size:12px;font-weight:600;color:#991b1b;margin-top:6px;">Slowest Completion - أبطأ إتمام</div>
                                    </div>
                                    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid #2563eb;border-radius:10px;padding:16px 14px;text-align:center;">
                                        <div style="font-size:28px;font-weight:700;color:#2563eb;"><field name="stat_processing" readonly="1"/></div>
                                        <div style="font-size:12px;font-weight:600;color:#1d4ed8;margin-top:6px;">Currently Processing - قيد المعالجة</div>
                                    </div>
                                </div>

                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">Document Processing Time - وقت معالجة المستندات</div>
                                <field name="stat_doc_line_ids" nolabel="1" readonly="1">
                                    <tree string="Document Stats" create="false" delete="false">
                                        <field name="label" string="Document Type - نوع المستند"/>
                                        <field name="count" string="Completed - مكتملة"/>
                                        <field name="avg_days" string="Avg Days - متوسط الأيام"/>
                                        <field name="fastest" string="Fastest - أسرع"/>
                                        <field name="slowest" string="Slowest - أبطأ"/>
                                    </tree>
                                </field>

                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;margin-top:20px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">Pass Processing Time - وقت معالجة التصاريح</div>
                                <field name="stat_pass_line_ids" nolabel="1" readonly="1">
                                    <tree string="Pass Stats" create="false" delete="false">
                                        <field name="label" string="Pass Type - نوع التصريح"/>
                                        <field name="count" string="Completed - مكتملة"/>
                                        <field name="avg_days" string="Avg Days - متوسط الأيام"/>
                                        <field name="fastest" string="Fastest - أسرع"/>
                                        <field name="slowest" string="Slowest - أبطأ"/>
                                    </tree>
                                </field>

                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;margin-top:20px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">HR Request Processing Time - وقت معالجة طلبات الموارد البشرية</div>
                                <field name="stat_hr_line_ids" nolabel="1" readonly="1">
                                    <tree string="HR Stats" create="false" delete="false">
                                        <field name="label" string="Request Type - نوع الطلب"/>
                                        <field name="count" string="Completed - مكتملة"/>
                                        <field name="avg_days" string="Avg Days - متوسط الأيام"/>
                                        <field name="fastest" string="Fastest - أسرع"/>
                                        <field name="slowest" string="Slowest - أبطأ"/>
                                    </tree>
                                </field>

                                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px;margin-top:20px;padding-bottom:6px;border-bottom:2px solid #e2e8f0;">By Nationality - حسب الجنسية</div>
                                <field name="stat_nat_line_ids" nolabel="1" readonly="1">
                                    <tree string="Nationality Stats" create="false" delete="false">
                                        <field name="label" string="Nationality - الجنسية"/>
                                        <field name="count" string="Completed - مكتملة"/>
                                        <field name="avg_days" string="Avg Days - متوسط الأيام"/>
                                        <field name="fastest" string="Fastest - أسرع"/>
                                        <field name="slowest" string="Slowest - أبطأ"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
